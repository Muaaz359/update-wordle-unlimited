# Apache Configuration for Wordle Unlimited
DirectoryIndex index.html index.php

# Clean URLs: Remove .html extensions & index.html from slugs
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Redirect direct request for index.html to clean directory URL
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ ./ [R=301,L]

  RewriteCond %{THE_REQUEST} \s/blog/index\.html[\s?] [NC]
  RewriteRule ^blog/index\.html$ blog/ [R=301,L]

  # Redirect legacy contact to canonical contact-us to prevent cannibalization
  RewriteRule ^contact/?$ contact-us [R=301,L]

  # 2. Redirect direct request with .html extension to clean URL without .html
  RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
  RewriteRule ^([^.]+)\.html$ $1 [R=301,L]

  # 3. Internally resolve clean URL to .html file if file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Browser Caching & Performance (1 Year for Static Assets, 0s for HTML)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Cache-Control Headers for Static Assets vs HTML Pages
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"

  # Immutable caching for static assets
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff2|ico)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Freshness for HTML pages
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>

# GZIP Compression for Maximum PageSpeed Performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml font/woff2
</IfModule>